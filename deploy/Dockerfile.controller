FROM golang:1.22-bookworm AS agent-build
WORKDIR /src
COPY agent /src/agent
WORKDIR /src/agent
RUN go build -o /lt-agent ./cmd/agent

FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /src
COPY backend /src/backend
COPY proto /src/proto
WORKDIR /src/backend
RUN apt-get update && apt-get install -y unzip curl && \
    curl -sL https://services.gradle.org/distributions/gradle-8.10.2-bin.zip -o /tmp/gradle.zip && \
    unzip -q /tmp/gradle.zip -d /opt && \
    /opt/gradle-8.10.2/bin/gradle bootJar --no-daemon

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build /src/backend/build/libs/lt-controller.jar /app/lt-controller.jar
COPY --from=agent-build /lt-agent /data/agent/lt-agent
RUN apt-get update && apt-get install -y --no-install-recommends curl tar gzip && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /data/artifacts /data/logs /data/certs /data/jmeter /data/agent && \
    chmod +x /data/agent/lt-agent
EXPOSE 8080 9090
ENTRYPOINT ["java", "-jar", "/app/lt-controller.jar"]
