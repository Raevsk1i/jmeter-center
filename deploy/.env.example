# Скопируйте в deploy/.env и при необходимости измените значения:
#   cp .env.example .env

LT_ADMIN_PASSWORD=admin
LT_MASTER_KEY=0123456789abcdef0123456789abcdef

# Host/IP that SSH-provisioned RHEL agents dial for gRPC (port 9090 must be reachable).
# Leave empty for Compose-only agents on the internal network; set for remote generators.
# LT_CONTROLLER_HOST=203.0.113.10

# UUID генераторов из UI/API (обязательны при запуске profile agents)
# DEMO_GENERATOR_ID=
# DEMO_GENERATOR_ID_2=

LT_BOOTSTRAP_TOKEN=demo
LT_AGENT_ID=agent-1
LT_AGENT_ID_2=agent-2
