# Скопируйте в deploy/.env:
#   cp .env.example .env
#
# Ниже — переменные, которые Compose подставляет в контейнеры.
# Полный справочник: см. README.md → «Переменные окружения».

# --- Основной стек (postgres + controller + frontend) -----------------------
LT_ADMIN_PASSWORD=admin
LT_MASTER_KEY=0123456789abcdef0123456789abcdef

# Опционально: публичный IP/DNS хоста с Controller (для ручной установки агента
# или Docker-агентов вне сети Compose). SSH-provisioning использует reverse tunnel
# и обычно НЕ требует открытого 9090 с генераторов.
# LT_CONTROLLER_HOST=203.0.113.10

# --- Только для profile agents (локальные demo-агенты в Docker) -------------
# Не нужны при обычном SSH-provisioning на RHEL.
# DEMO_GENERATOR_ID=
# DEMO_GENERATOR_ID_2=
# LT_BOOTSTRAP_TOKEN=demo
# LT_AGENT_ID=agent-1
# LT_AGENT_ID_2=agent-2
